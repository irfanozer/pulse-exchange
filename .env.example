POSTGRES_DB=pulseexchange
POSTGRES_USER=pulseexchange
POSTGRES_PASSWORD=pulseexchange
PULSEEXCHANGE_DATABASE_URL=postgresql+asyncpg://pulseexchange:pulseexchange@db:5432/pulseexchange
PULSEEXCHANGE_PROCESSOR_ENABLED=false
PULSEEXCHANGE_EVENT_RELAY_ENABLED=true
PULSEEXCHANGE_PROCESSOR_POLL_INTERVAL_MS=50
PULSEEXCHANGE_PROCESSOR_ERROR_BACKOFF_MS=1000
PULSEEXCHANGE_PROCESSOR_HEARTBEAT_INTERVAL_SECONDS=2
PULSEEXCHANGE_PROCESSOR_HEARTBEAT_STALE_SECONDS=10
PULSEEXCHANGE_WEBSOCKET_REPLAY_LIMIT=100
PULSEEXCHANGE_MAX_WEBSOCKET_CONNECTIONS=100
PULSEEXCHANGE_MUTATION_RATE_LIMIT=120
PULSEEXCHANGE_MUTATION_RATE_WINDOW_SECONDS=60
PULSEEXCHANGE_TRUST_PROXY_HEADERS=false
PULSEEXCHANGE_MAX_REQUEST_BODY_BYTES=16384
PULSEEXCHANGE_MAX_QUEUED_COMMANDS=1000
PULSEEXCHANGE_MAX_TOTAL_COMMANDS=100000
PULSEEXCHANGE_CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]
PULSEEXCHANGE_ALLOWED_HOSTS=["api","localhost","127.0.0.1","testserver"]
PULSEEXCHANGE_WEBSOCKET_ORIGINS=["http://localhost:3001","http://localhost:5173"]
PULSEEXCHANGE_REQUIRE_PROCESSOR_FOR_READINESS=false
PULSEEXCHANGE_WORKER_HEALTH_PORT=8002
PULSEEXCHANGE_SEED_MARKET=true
PULSEEXCHANGE_SEED_STARTUP_TIMEOUT_SECONDS=90
PULSEEXCHANGE_SEED_COMMAND_TIMEOUT_SECONDS=20
